# ==============================
# Lạng Sơn 360 - Git Ignore
# ==============================

# Hệ điều hành
.DS_Store
Thumbs.db
Desktop.ini

# Windows
$RECYCLE.BIN/
*.lnk

# VS Code
.vscode/
*.code-workspace

# JetBrains / IntelliJ / WebStorm
.idea/
*.iml

# Node.js / npm (nếu phát triển thêm trong tương lai)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment / secrets
.env
.env.*
!.env.example

# Build / cache
dist/
build/
coverage/
.cache/
.parcel-cache/
.next/
.nuxt/

# Temporary files
*.tmp
*.temp
*.log
*.bak
*.swp
*.swo

# Python (nếu có công cụ hỗ trợ trong tương lai)
__pycache__/
*.py[cod]
.venv/
venv/
env/

# OS/editor temporary files
*.orig
